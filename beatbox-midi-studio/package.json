{
  "name": "beatbox-midi-studio",
  "version": "1.0.0",
  "description": "Beatboxing to MIDI with Strudel - Voice percussion recorder",
  "main": "server.js",
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "prod": "NODE_ENV=production node server.js",
    "server:dev": "nodemon server.js",
    "client:dev": "vite",
    "client:build": "vite build",
    "build": "npm run client:build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "backblaze-b2": "^1.7.0",
    "better-sqlite3": "^9.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
